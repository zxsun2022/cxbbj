---
// 覆盖 Starlight 默认的 SocialIcons：在页头右侧注入一个「收起/展开左侧导航栏」按钮（仅 PC 端显示）。
// 同时保留原有的社交链接渲染逻辑，未来在 astro.config 的 social 里新增链接仍可正常显示。
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';

const links = config.social || [];
---

<button
	type="button"
	id="sidebar-collapse-toggle"
	class="sidebar-collapse-toggle sl-flex"
	aria-label="收起或展开左侧导航栏"
	title="收起 / 展开侧边栏"
	aria-pressed="false"
>
	<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none"
		stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<rect x="3" y="4" width="18" height="16" rx="2"></rect>
		<line x1="9" y1="4" x2="9" y2="20"></line>
	</svg>
</button>

{
	links.length > 0 && (
		<>
			{links.map(({ label, href, icon }) => (
				<a {href} rel="me" class="sl-flex social-link">
					<span class="sr-only">{label}</span>
					<Icon name={icon} />
				</a>
			))}
		</>
	)
}

<script is:inline>
	(() => {
		const KEY = 'sidebar-collapsed';
		const root = document.documentElement;
		const sync = () => {
			const collapsed = root.classList.contains('sidebar-collapsed');
			const btn = document.getElementById('sidebar-collapse-toggle');
			if (btn) btn.setAttribute('aria-pressed', String(collapsed));
		};
		// 初始状态已由 <head> 内联脚本设置，这里仅同步按钮的无障碍状态。
		sync();
		document.addEventListener('click', (e) => {
			const btn = e.target.closest && e.target.closest('#sidebar-collapse-toggle');
			if (!btn) return;
			const collapsed = !root.classList.contains('sidebar-collapsed');
			root.classList.toggle('sidebar-collapsed', collapsed);
			try {
				localStorage.setItem(KEY, String(collapsed));
			} catch (_) {}
			sync();
		});
	})();
</script>

<style>
	.sidebar-collapse-toggle {
		align-items: center;
		justify-content: center;
		border: 0;
		background: transparent;
		color: var(--sl-color-text-accent);
		cursor: pointer;
		padding: 0.4em;
		margin: -0.4em;
		border-radius: 0.375rem;
	}
	.sidebar-collapse-toggle:hover {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
	}
	/* 仅在显示左侧边栏的桌面断点暴露该按钮，移动端边栏是抽屉，无需此功能 */
	@media (max-width: 50rem) {
		.sidebar-collapse-toggle {
			display: none;
		}
	}
	.social-link {
		color: var(--sl-color-text-accent);
		padding: 0.5em;
		margin: -0.5em;
	}
	.social-link:hover {
		color: var(--sl-color-white);
	}
</style>
